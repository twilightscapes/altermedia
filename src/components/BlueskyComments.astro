---
/**
 * Bluesky replies as this post's comment section.
 *
 * Comments live in the commenters' own AT Proto repos — not in any hub
 * database. This component just renders them: it finds the Bluesky post that
 * links to this page (or uses an explicit at:// URI from frontmatter), then
 * loads its reply thread from the public AppView API. Client-side, no auth,
 * no backend.
 */
import settings from '../content/settings.json';

interface Props {
  /** Canonical URL of this page (what the Bluesky cross-post links to) */
  postUrl: string;
  /** Explicit at:// URI of the Bluesky post, skips discovery */
  blueskyUri?: string;
}

const { postUrl, blueskyUri = '' } = Astro.props;
const at = (settings as any).atproto || {};
const handle = (at.handle || '').trim().replace(/^@/, '');
const enabled = at.comments !== false && (handle || blueskyUri);
---

{enabled && (
  <section id="bsky-comments" class="mt-12 border-t border-theme-border pt-8"
    data-post-url={postUrl} data-bsky-uri={blueskyUri} data-handle={handle}>
    <div class="mb-4 flex items-center justify-between gap-4">
      <h2 class="text-xl font-semibold">Comments</h2>
      <a id="bsky-thread-link" href="https://bsky.app" target="_blank" rel="noopener"
        class="hidden text-sm text-theme-primary hover:underline">Reply on Bluesky ↗</a>
    </div>
    <p id="bsky-comments-status" class="text-sm text-theme-faint">Loading comments…</p>
    <div id="bsky-comments-meta" class="hidden mb-4 flex gap-4 text-sm text-theme-muted"></div>
    <div id="bsky-comments-list" class="space-y-4"></div>
    <button id="bsky-comments-more" class="mt-6 hidden rounded border border-theme-border px-4 py-2 text-sm text-theme-muted transition hover:bg-theme-surface-hover">Show more comments</button>
  </section>

  <script is:inline>
    (function () {
      const root = document.getElementById('bsky-comments');
      if (!root) return;
      const API = 'https://public.api.bsky.app/xrpc';
      const statusEl = document.getElementById('bsky-comments-status');
      const listEl = document.getElementById('bsky-comments-list');
      const metaEl = document.getElementById('bsky-comments-meta');
      const linkEl = document.getElementById('bsky-thread-link');
      const postUrl = root.dataset.postUrl;
      const handle = root.dataset.handle;
      let uri = root.dataset.bskyUri;

      const esc = (s) => { const d = document.createElement('div'); d.textContent = s || ''; return d.innerHTML; };
      const webUrl = (atUri) => {
        const m = atUri.match(/^at:\/\/([^/]+)\/app\.bsky\.feed\.post\/(.+)$/);
        return m ? `https://bsky.app/profile/${m[1]}/post/${m[2]}` : 'https://bsky.app';
      };
      const when = (iso) => {
        try {
          const d = new Date(iso), days = (Date.now() - d) / 86400000;
          if (days < 1) return d.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
          if (days < 365) return d.toLocaleDateString([], { month: 'short', day: 'numeric' });
          return d.toLocaleDateString([], { year: 'numeric', month: 'short', day: 'numeric' });
        } catch { return ''; }
      };

      // A post "links here" if its external embed, link facets, or text carry
      // this page's URL (with or without trailing slash).
      function linksHere(record) {
        const targets = [postUrl, postUrl.replace(/\/$/, ''), postUrl.replace(/\/?$/, '/')];
        const uris = [];
        if (record?.embed?.external?.uri) uris.push(record.embed.external.uri);
        for (const f of record?.facets || [])
          for (const feat of f.features || [])
            if (feat.uri) uris.push(feat.uri);
        if (record?.text) uris.push(...targets.filter((t) => record.text.includes(t)));
        return uris.some((u) => targets.includes(u));
      }

      async function discover() {
        if (uri) return uri;
        const cacheKey = `bsky_uri:${postUrl}`;
        const cached = sessionStorage.getItem(cacheKey);
        if (cached) return cached === 'none' ? '' : cached;
        let cursor = '', found = '';
        for (let page = 0; page < 3 && !found; page++) {
          const res = await fetch(`${API}/app.bsky.feed.getAuthorFeed?actor=${encodeURIComponent(handle)}&limit=100&filter=posts_no_replies${cursor ? `&cursor=${encodeURIComponent(cursor)}` : ''}`);
          if (!res.ok) break;
          const data = await res.json();
          for (const item of data.feed || []) {
            if (item.post?.record && linksHere(item.post.record)) { found = item.post.uri; break; }
          }
          cursor = data.cursor;
          if (!cursor) break;
        }
        sessionStorage.setItem(cacheKey, found || 'none');
        return found;
      }

      // Keep the page a sane height: 25 top-level comments per click of
      // "Show more", at most 3 nested replies shown per comment (the full
      // thread is one click away on Bluesky).
      const PAGE = 25;
      const MAX_KIDS = 3;

      function renderReply(node, depth) {
        const p = node.post;
        if (!p) return '';
        const author = p.author || {};
        const allKids = (node.replies || [])
          .sort((a, b) => new Date(a.post?.record?.createdAt || 0) - new Date(b.post?.record?.createdAt || 0));
        const shown = depth >= 2 ? [] : allKids.slice(0, MAX_KIDS);
        const hidden = allKids.length - shown.length;
        const kids = shown.map((r) => renderReply(r, depth + 1)).join('') +
          (hidden > 0 ? `<p class="text-xs text-theme-faint"><a href="${webUrl(p.uri)}" target="_blank" rel="noopener" class="hover:underline">${hidden} more repl${hidden === 1 ? 'y' : 'ies'} on Bluesky ↗</a></p>` : '');
        return `
          <div class="flex gap-3 ${depth > 0 ? 'ml-6 md:ml-10' : ''}">
            <img src="${esc(author.avatar || '')}" alt="" loading="lazy"
              class="h-9 w-9 shrink-0 rounded-full bg-theme-surface object-cover" onerror="this.style.visibility='hidden'" />
            <div class="min-w-0 flex-1">
              <p class="text-sm">
                <a href="https://bsky.app/profile/${esc(author.handle)}" target="_blank" rel="noopener" class="font-medium hover:underline">${esc(author.displayName || author.handle)}</a>
                <span class="text-theme-faint">@${esc(author.handle)} · ${when(p.record?.createdAt)}</span>
              </p>
              <p class="mt-0.5 whitespace-pre-wrap break-words text-sm text-theme-muted">${esc(p.record?.text)}</p>
              <p class="mt-1 text-xs text-theme-faint">
                ♥ ${p.likeCount || 0}
                · <a href="${webUrl(p.uri)}" target="_blank" rel="noopener" class="hover:underline">reply</a>
              </p>
              ${kids ? `<div class="mt-3 space-y-3">${kids}</div>` : ''}
            </div>
          </div>`;
      }

      async function load() {
        try {
          const found = await discover();
          if (!found) {
            statusEl.textContent = handle
              ? `No Bluesky conversation yet — share this post from @${handle} to start one.`
              : 'No Bluesky conversation linked to this post yet.';
            return;
          }
          const res = await fetch(`${API}/app.bsky.feed.getPostThread?uri=${encodeURIComponent(found)}&depth=10`);
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const thread = (await res.json()).thread;
          const p = thread?.post;
          if (!p) throw new Error('no thread');
          linkEl.href = webUrl(p.uri);
          linkEl.classList.remove('hidden');
          metaEl.innerHTML = `<span>♥ ${p.likeCount || 0} likes</span><span>↻ ${p.repostCount || 0} reposts</span><span>💬 ${p.replyCount || 0} replies</span>`;
          metaEl.classList.remove('hidden');
          const replies = (thread.replies || [])
            .sort((a, b) => new Date(a.post?.record?.createdAt || 0) - new Date(b.post?.record?.createdAt || 0));
          if (!replies.length) {
            statusEl.textContent = 'No comments yet — be the first to reply on Bluesky.';
            return;
          }
          statusEl.remove();
          const moreBtn = document.getElementById('bsky-comments-more');
          let shown = 0;
          function showMore() {
            const batch = replies.slice(shown, shown + PAGE);
            shown += batch.length;
            listEl.insertAdjacentHTML('beforeend', batch.map((r) => renderReply(r, 0)).join(''));
            const left = replies.length - shown;
            moreBtn.textContent = `Show more comments (${left})`;
            moreBtn.classList.toggle('hidden', left <= 0);
          }
          moreBtn.addEventListener('click', showMore);
          showMore();
        } catch (err) {
          statusEl.textContent = 'Comments are unavailable right now.';
        }
      }

      load();
    })();
  </script>
)}
