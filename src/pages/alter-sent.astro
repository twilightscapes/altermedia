---
import AlterBase from '../layouts/AlterBase.astro';

---

<AlterBase
  title="Report sent · Alter"
  description="Your Alter feedback has been sent."
>
  <article class="prose">
    <h1 tabindex="-1">Thank you — your report is on its way</h1>
    <p class="lede">
      We've received it. If you left an email address, we'll reply there. Every
      report makes Alter better.
    </p>
    <div class="cta-row">
      <a class="btn-link" href="/">Back to Alter →</a>
    </div>
  </article>
</AlterBase>
