              <ul>
                <li class="as-tree-folder">2012
                  <ul>
                    <li class="as-tree-project">Big Bend <span>48</span></li>
                    <li class="as-tree-album">Selects <span>12</span></li>
                  </ul>
                </li>
                <li class="as-tree-project">Panhandle <span>31</span></li>
              </ul>
            </li>
            <li class="as-tree-folder">Night work
              <ul>
                <li class="as-tree-project">Futuro house <span>22</span></li>
              </ul>
