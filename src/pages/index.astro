        <div class="as-keys-stage" data-keys-stage>
          <div class="as-keys-photo">
            <img
              data-keys-img
              src={`${IMG}/pump-alter.webp`}
              data-edit={`${IMG}/pump-alter.webp`}
              data-master={`${IMG}/pump-as-shot.webp`}
              alt="An old red and white gas pump at night, marked 3 and Super Unleaded, in front of a shuttered building with an ICE sign, warm-toned with a dark vignette."
              width="924"
