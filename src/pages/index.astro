      <nav class="as-jump-inline reveal" aria-label="Jump to a feature">
        {sections.map((s) => <a href={`#${s.id}`}>{s.eyebrow}</a>)}
      </nav>
    </section>

    {
      sections.map((section) => (
        <section class="as-section" id={section.id}>
          <div class="as-intro reveal">
            <p class="as-eyebrow">{section.eyebrow}</p>
            <h2>{section.title}</h2>
            <p class="as-lede" set:html={section.lede} />
          </div>

          {section.hero.src ? (
            <img
              class="as-shot-img reveal"
              src={section.hero.src}
              alt={section.hero.alt}
              width={Math.round((section.hero.w ?? 0) / 2)}
              height={Math.round((section.hero.h ?? 0) / 2)}
              loading="lazy"
              decoding="async"
            />
          ) : SHOW_SHOT_PLACEHOLDERS ? (
            <div class="as-shot reveal" style={`--ratio: ${section.hero.ratio ?? '16 / 10'}`}>
              <span class="as-shot-tag">Shot needed</span>
              <p>{section.hero.brief}</p>
            </div>
          ) : null}

          <div class="as-chapters">
            {section.chapters.map((ch, i) => (
              <details class="as-chapter reveal" open={i === 0}>
                <summary>
                  <span class="as-chapter-title">{ch.title}</span>
                  <span class="as-chevron" aria-hidden="true" />
                </summary>
                <div class="as-chapter-body">
                  {ch.body.map((p) => (
                    <p set:html={p} />
                  ))}

                  {ch.specs && (
                    <dl class="as-specs">
                      {ch.specs.map((s) => (
                        <div class="as-spec">
                          <dt>{s.label}</dt>
                          <dd>{s.value}</dd>
                        </div>
                      ))}
                    </dl>
                  )}

                  {ch.shots?.map((shot) =>
                    shot.src ? (
                      <img
                        class="as-shot-img as-shot-img-inline"
                        src={shot.src}
                        alt={shot.alt}
                        width={Math.round((shot.w ?? 0) / 2)}
                        height={Math.round((shot.h ?? 0) / 2)}
                        loading="lazy"
                        decoding="async"
                      />
                    ) : SHOW_SHOT_PLACEHOLDERS ? (
                      <div class="as-shot as-shot-inline" style={shotStyle(shot.ratio ?? '16 / 9')}>
                        <span class="as-shot-tag">Shot needed</span>
                        <p>{shot.brief}</p>
                      </div>
                    ) : null
                  )}
                </div>
              </details>
            ))}
          </div>
        </section>
      ))
    }

    <!-- ── Download ──────────────────────────────────────────────────── -->
    <section class="as-section as-beta reveal" id="download">
      <!-- Old #beta links (announcements, early testers) still land here. -->
      <span id="beta" aria-hidden="true"></span>
      <div class="as-download-head">
        <img
          src="/images/alter-icon.png"
          alt=""
          width="96"
          height="96"
          class="as-appicon as-appicon-small"
        />
        <p class="as-eyebrow">Download</p>
        <h2>Welcome back.</h2>
        <p class="as-lede">
          Download Alter, double-click your Aperture library, and pick up where
          you left off.
        </p>
        <p class="as-cta">
          <a class="as-store" href={page.appStoreUrl}>
            <img src={APP_STORE_BADGE} alt="Download on the Mac App Store" width="156" height="40" />
          </a>
          <a class="as-btn as-btn-quiet" href={SOURCE_URL}>Read the source</a>
        </p>
        <p class="as-fine">{page.finePrint}</p>
        <p class="as-fine as-direct">
          Prefer a direct download? <a href={page.downloadUrl}>Download the Mac disk image</a>.
        </p>
      </div>

      <div class="as-chapters">
        <details class="as-chapter" open>
          <summary>
            <span class="as-chapter-title">Will Alter change my Aperture library?</span>
            <span class="as-chevron" aria-hidden="true"></span>
          </summary>
          <div class="as-chapter-body">
            <p>
              No. Alter opens it read-only and never writes inside the
              <code>.aplibrary</code> package. Its own catalog lives beside it,
              in a separate file.
            </p>
          </div>
        </details>

        <details class="as-chapter">
          <summary>
            <span class="as-chapter-title">Do I need Aperture installed?</span>
            <span class="as-chevron" aria-hidden="true"></span>
          </summary>
          <div class="as-chapter-body">
            <p>
              No. Alter reads the library itself, so it works on Macs that can
              no longer run Aperture.
            </p>
          </div>
        </details>

        <details class="as-chapter">
          <summary>
            <span class="as-chapter-title">My masters are on another drive.</span>
            <span class="as-chevron" aria-hidden="true"></span>
          </summary>
          <div class="as-chapter-body">
            <p>
              Connect the drive before you open the library. Alter looks for
              each referenced master at the path Aperture recorded.
            </p>
          </div>
        </details>

        <details class="as-chapter">
          <summary>
            <span class="as-chapter-title">What happens if you stop making Alter?</span>
            <span class="as-chevron" aria-hidden="true"></span>
          </summary>
          <div class="as-chapter-body">
            <p>
              Alter keeps going. Its core is open source under the
              <a href="https://mozilla.org/MPL/2.0/">Mozilla Public License 2.0</a>,
              so anyone can <a href={SOURCE_URL}>build it, fix it and carry it
              on</a>. And your originals and your Aperture library never
              depended on Alter in the first place.
            </p>
          </div>
        </details>

        <details class="as-chapter">
          <summary>
            <span class="as-chapter-title">Is it really free?</span>
            <span class="as-chevron" aria-hidden="true"></span>
          </summary>
          <div class="as-chapter-body">
            <p>Yes. Alter 1.0 is free to download and use.</p>
          </div>
        </details>

        <details class="as-chapter">
          <summary>
            <span class="as-chapter-title">What's inside</span>
            <span class="as-chevron" aria-hidden="true"></span>
          </summary>
          <div class="as-chapter-body">
            <ul class="as-list">
              <li>
                <strong>Your Aperture library</strong> — projects, folders,
                albums, versions, stacks, ratings, labels, keywords, captions
                and adjustments, read in place and never modified.
              </li>
              <li>
                <strong>A real library</strong> — referenced originals, folders,
                albums, ratings, flags, filters, fast sorting, and search across
                every metadata field. Videos are first-class citizens.
              </li>
              <li>
                <strong>Aperture’s tools</strong> — adjustment bricks with Brush
                In and Brush Away, Quick Brushes, Levels and Curves, the Loupe,
                Straighten, Crop, Retouch, Red Eye, Lift &amp; Stamp, Full
                Screen with HUDs, and Aperture’s keyboard shortcuts.
              </li>
              <li>
                <strong>The timeline editor</strong> — cut clips from <em>any number of videos</em> into one sequence; layer styled
                text, images, other videos, and audio; keyframe with easing; type
                text right on the canvas. Animated GIFs join the timeline as
                clips. What you preview is exactly what exports.
              </li>
              <li>
                <strong>Web layers</strong> — load any web page live inside Alter
                and capture it as a layer: a snapshot for stills, or a timed
                recording that drops in as video you can trim, keyframe, and
                animate like anything else.
              </li>
              <li>
                <strong>AI descriptions</strong> — one click describes photos and
                videos: titles, captions, and embedded accessibility text, with
                video speech transcribed privately on your Mac and woven into the
                description.
              </li>
              <li>
                <strong>Publish anywhere</strong> — accessible web galleries to
                your own GitHub Pages, Apple&nbsp;TV via the Twilightscapes app,
                Bluesky posts with scheduling and engagement stats, and a
                one-click hand-off to the X composer.
              </li>
              <li>
                <strong>VoiceOver throughout</strong> — generated ALT text is read
                aloud, the grid announces which photos still need descriptions,
                and the timeline editor is labelled end to end.
              </li>
            </ul>
          </div>
        </details>

        <details class="as-chapter" id="feedback" style="scroll-margin-top: 5rem">
          <summary>
            <span class="as-chapter-title">Send us feedback</span>
            <span class="as-chevron" aria-hidden="true"></span>
          </summary>
          <div class="as-chapter-body">
            <p>
              Found something broken or missing? Something Aperture did that
              Alter doesn’t yet? Tell us — it comes straight to us.
            </p>

            <form
              class="beta-form"
              name="alter-beta"
              method="POST"
              data-netlify="true"
              data-netlify-honeypot="bot-field"
              action="/alter-sent/"
            >
              <!-- Backend name stays "alter-beta" so Netlify keeps one
                   continuous submissions history across the beta and 1.0. -->
              <input type="hidden" name="form-name" value="alter-beta" />
              <p class="hp" hidden aria-hidden="true">
                <label>Leave this field empty: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
              </p>

              <div class="beta-field">
                <label for="beta-email">Email <span class="beta-opt">(optional, so we can reply)</span></label>
                <input id="beta-email" name="email" type="email" autocomplete="email" />
              </div>

              <div class="beta-field">
                <label for="beta-version">Alter version <span class="beta-opt">(optional — it's in Settings, bottom line)</span></label>
                <input id="beta-version" name="version" type="text" placeholder="e.g. 1.0.0" />
              </div>

              <div class="beta-field">
                <label for="beta-message">What happened? <span class="beta-req">(required)</span></label>
                <textarea id="beta-message" name="message" required aria-required="true"
                  placeholder="What broke, what's missing, or what surprised you?"></textarea>
              </div>

              <button type="submit" class="btn-primary">Send feedback</button>
            </form>
            <script>
              // altermedia.app/#feedback is the App Store support link — open
              // the form when someone arrives that way.
              const openFeedback = () => {
                const el = document.getElementById('feedback');
                if (location.hash === '#feedback' && el instanceof HTMLDetailsElement) {
                  el.open = true;
                  el.scrollIntoView();
                }
              };
              openFeedback();
              addEventListener('hashchange', openFeedback);
              // Images above it shift the page while they load.
              addEventListener('load', openFeedback);
            </script>
          </div>
        </details>
      </div>
    </section>

    <!-- ── Close ─────────────────────────────────────────────────────── -->
    <section class="as-close reveal">
      <h2>Nothing locked in. Ever.</h2>
      <p class="as-lede">
        Your originals stay yours, in place, in their own folders. Your Aperture
