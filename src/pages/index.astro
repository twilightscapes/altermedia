    <!-- ── Organising ────────────────────────────────────────────────── -->
    <section class="as-section" id="organise">
      <div class="as-intro reveal">
        <p class="as-eyebrow">Organised your way</p>
        <h2>Projects, versions, stacks. Still yours.</h2>
        <p class="as-lede">
          Projects inside folders, albums inside projects. Versions under one
