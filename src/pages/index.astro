      <div class="as-wide reveal">
        <div class="as-loupe-stage" data-loupe>
          <img
            class="as-loupe-photo"
            src={`${IMG}/bigbend-alter.webp`}
            alt="A crumbling adobe and stone building in the Big Bend desert at dusk, red rock hills behind it under a moody grey sky, dry brush and stones in the foreground."
            width="2928"
            height="1951"
            loading="lazy"
            decoding="async"
            crossorigin="anonymous"
          />
          <div class="as-loupe" data-loupe-lens tabindex="0" role="img" aria-label="Loupe — use the arrow keys to move it">
            <span class="as-loupe-rgb" data-loupe-rgb>R — G — B —</span>
