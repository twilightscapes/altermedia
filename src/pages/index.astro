---
import AlterBase from '../layouts/AlterBase.astro';
import alterData from '../content/alter/sections.json';
import page from '../content/alter/page.json';

const sections = alterData.sections;

// Flip to true to see briefs for shots that haven't been captured yet.
const SHOW_SHOT_PLACEHOLDERS = false;

/**
 * Inline shots are capped by *height*, not width, so a portrait 3/4 close-up
 * doesn't render a metre tall next to a landscape one.
 */
const INLINE_SHOT_CAP = 430;
function shotStyle(ratio, cap = INLINE_SHOT_CAP) {
  const [w, h] = ratio.split('/').map((n) => Number(n.trim()));
  const maxW = Number.isFinite(w) && Number.isFinite(h) && h > 0
    ? Math.round(cap * (w / h))
    : 0;
  return `--ratio: ${ratio};` + (maxW ? ` max-width: min(100%, ${maxW}px);` : '');
}

const SOURCE_URL = 'https://github.com/twilightscapes/alter';
// Apple's official badge, served by Apple (marketing toolbox) — not to be redrawn.
const APP_STORE_BADGE =
  'https://toolbox.marketingtools.apple.com/api/v2/badges/download-on-the-mac-app-store/black/en-us';
const IMG = '/images/alter/aperture';

/** What an Aperture library brings with it (all verified against a real library). */
const comesAcross = [
  ['Projects & folders', 'Nested exactly as you filed them'],
  ['Albums & smart albums', 'Smart albums keep their rules wherever Alter has an equivalent'],
  ['Versions & stacks', 'Every version under its master, every stack with its pick'],
  ['Ratings, flags & labels', 'Stars, rejects, flags and the seven colour labels'],
  ['Keywords', 'Your keyword library, hierarchy and all'],
  ['Titles & captions', 'Plus creator, copyright and camera data'],
  ['Adjustments', 'Rebuilt from Aperture’s recipe, live and non-destructive'],
  ['Crops, brushes & retouching', 'Straightening, brushed-in edits and repair spots'],
];

/** On-screen keys for the keyboard demo. `key` is what the page listens for. */
const demoKeys = [
  { key: '1', cap: '1', label: '★' },
  { key: '2', cap: '2', label: '★★' },
  { key: '3', cap: '3', label: '★★★' },
  { key: '4', cap: '4', label: '★★★★' },
  { key: '5', cap: '5', label: '★★★★★' },
  { key: '0', cap: '0', label: 'Clear' },
  { key: '9', cap: '9', label: 'Reject' },
  { key: '/', cap: '/', label: 'Flag' },
  { key: 'm', cap: 'M', label: 'Master' },
  { key: 'z', cap: 'Z', label: 'Zoom' },
  { key: 'f', cap: 'F', label: 'Full Screen' },
  { key: 'h', cap: 'H', label: 'HUD' },
];

/** The reference table under the demo — Alter's real shortcuts. */
const keyTable = [
  ['1 – 5', 'Rate'],
  ['0', 'Clear the rating'],
  ['9', 'Reject'],
  ['= and −', 'Raise or lower the rating'],
  ['/', 'Flag'],
  ['⌃1 – ⌃7', 'Colour label'],
  ['V', 'Browser, Split View, Viewer'],
  ['W', 'Cycle the Inspector tabs'],
  ['F', 'Full Screen'],
  ['H', 'Inspector HUD, in Full Screen'],
  ['⇧H', 'Keywords HUD'],
  ['O', 'Lift & Stamp'],
  ['`', 'The Loupe'],
  ['Z', 'Zoom to 100%'],
  ['M', 'Show the master'],
  ['⌥M', 'Compare with the original'],
  ['C', 'Crop'],
  ['G', 'Straighten'],
  ['X', 'Retouch'],
  ['E', 'Red Eye'],
  ['S', 'Select'],
  ['I', 'Show or hide the Inspector'],
  ['[ and ]', 'Rotate'],
  ['⌘[ and ⌘]', 'Promote and demote in a stack'],
  ['⌘P', 'Print'],
];

const loupeZooms = [0.5, 1, 2, 4, 8, 16];

/** What's hidden in the Select demo's photo (masks in /images/alter/select). */
const selectObjects = [
  { id: 'sky', name: 'The sky' },
  { id: 'hill', name: 'The red hill' },
  { id: 'building', name: 'The adobe' },
  { id: 'window', name: 'A window' },
  { id: 'rocks', name: 'The rock pile' },
  { id: 'ground', name: 'The sand' },
];
---

<AlterBase
  title={page.title}
  description={page.description}
  image="/og-alter-continued.webp"
>
  <div class="as">
    <!-- ── Hero ──────────────────────────────────────────────────────── -->
    <header class="as-hero reveal">
      <div class="as-brand">
        <img
          class="as-appicon"
          src="/images/alter-icon.png"
          alt="Alter app icon — a camera lens seen head-on on an aluminium tile, ALTER LENS engraved on its ring"
          width="128"
          height="128"
        />
        <!-- Stretched to exactly the width of the icon's visible tile (824 of
             its 1024 pixels), whatever font the visitor's system draws it in. -->
        <svg class="as-wordmark" viewBox="0 0 824 300" role="img" aria-label="Alter">
          <text x="412" y="292" text-anchor="middle" textLength="824" lengthAdjust="spacingAndGlyphs">Alter</text>
        </svg>
      </div>
      <p class="as-eyebrow as-eyebrow-hero">For everyone who never got over Aperture</p>
      <h1>Aperture,<br />continued.</h1>
      <p class="as-lede">
        Alter opens your Aperture library exactly as you left it — every
        project, version, rating, keyword and adjustment — and keeps going.
        Same keys. Same tools. And this time it’s open source, so nobody can
        take it away from you.
      </p>
      <p class="as-cta">
        <a class="as-store" href={page.appStoreUrl}>
          <img src={APP_STORE_BADGE} alt="Download on the Mac App Store" width="156" height="40" />
        </a>
        <a class="as-btn as-btn-quiet" href={SOURCE_URL}>Read the source</a>
      </p>
      <p class="as-fine">{page.finePrint}</p>
    </header>

    <figure class="as-wide as-hero-shot reveal">
      <img
        src={`${IMG}/hero-aperture.webp`}
        alt="Alter with an Aperture library open. The sidebar lists the library’s projects — 1-2-2011, 2010, 2uf, BIGBEND, Cisco, Dennison, FortWorth and more. The viewer shows a night photo of a weathered Futuro house, its round windows glowing green and purple against a starry sky, with a filmstrip of night shots below. On the right, the Adjust inspector shows the photo’s Aperture edit as bricks: White Balance at 5706 K, Exposure +0.55, Enhance with Definition +0.49, Highlights & Shadows, Levels with its histogram, and Color. The status bar reads “Aperture library — originals untouched”."
        width="1240"
        height="807"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </figure>

    <!-- ── Section nav ───────────────────────────────────────────────── -->
    <nav class="as-jump reveal" aria-label="Jump to a section">
      <a href="#open">Open source</a>
      <a href="#yours">Your library</a>
      <a href="#edits">Your edits</a>
      <a href="#new">What’s new</a>
      <a href="#bricks">The tools</a>
      <a href="#select">Select</a>
      <a href="#loupe">The Loupe</a>
      <a href="#keys">The keys</a>
      <a href="#organise">Organising</a>
      <a href="#more">And more</a>
      <a href="#download">Download</a>
    </nav>

    <!-- ── Open source ───────────────────────────────────────────────── -->
    <section class="as-section as-open" id="open">
      <div class="as-intro reveal">
        <p class="as-eyebrow">Open source</p>
        <h2>This time, it can’t be taken away.</h2>
        <p class="as-lede">
          Apple stopped developing Aperture in 2014, and since macOS Catalina
          it won’t even open. Years of work — your projects, your keywords,
          your edits — stranded by a decision nobody asked you about. Alter is
          built so that can’t happen again: its core is open source, published
          in full under the Mozilla Public License.
        </p>
      </div>

      <ol class="as-timeline reveal" aria-label="From Aperture to Alter">
        <li>
          <span class="as-tl-year">2005</span>
          <strong>Aperture 1.0</strong>
          <span>A professional photo library from Apple, with the tools to match.</span>
        </li>
        <li>
          <span class="as-tl-year">2014</span>
          <strong>Development stops</strong>
          <span>No more features. Before long, no more fixes.</span>
        </li>
        <li>
          <span class="as-tl-year">2019</span>
          <strong>macOS Catalina</strong>
          <span>Aperture won’t launch. Your library sits in a folder nothing can read.</span>
        </li>
        <li class="as-tl-now">
          <span class="as-tl-year">Today</span>
          <strong>Alter</strong>
          <span>Opens that library as you left it — and publishes every line of its core.</span>
        </li>
      </ol>

      <div class="as-pillars">
        <article class="as-pillar reveal">
          <span class="as-pillar-icon" aria-hidden="true">{'{ }'}</span>
          <h3>Open source, for good</h3>
          <p>
            The library, the Aperture reader, the editor and the viewer are
            public under the MPL&nbsp;2.0. Read it, build it, fix it. If we
            ever stopped, anyone could pick Alter up and keep it going.
          </p>
        </article>
        <article class="as-pillar reveal">
          <span class="as-pillar-icon" aria-hidden="true">⇄</span>
          <h3>Nothing held hostage</h3>
          <p>
            Photos you import stay in their own folders, with titles, captions
            and keywords written into the files as standard metadata. Alter’s
            catalog is a plain SQLite file beside your photos — readable by
            anything.
          </p>
        </article>
        <article class="as-pillar reveal">
          <span class="as-pillar-icon" aria-hidden="true">◎</span>
          <h3>Your Aperture library, untouched</h3>
          <p>
            Alter reads it and never writes inside it. Keep it as your
            archive and open it in Alter as often as you like — it stays
            exactly as Aperture left it.
          </p>
        </article>
      </div>

      <div class="as-terminal reveal">
        <div class="as-terminal-bar">
          <span class="as-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="as-terminal-title">Build Alter yourself</span>
          <button type="button" class="as-copy" data-copy="#build-steps">Copy</button>
        </div>
        <pre id="build-steps"><code>git clone {SOURCE_URL}
cd alter && xcodegen generate
open Alter.xcodeproj</code></pre>
        <p class="as-terminal-foot">
          <a href={SOURCE_URL}>github.com/twilightscapes/alter</a>
          <span>Mozilla Public License 2.0 · Swift · macOS 13 or later</span>
        </p>
      </div>
    </section>

    <!-- ── Your library ──────────────────────────────────────────────── -->
    <section class="as-section" id="yours">
      <div class="as-intro reveal">
        <p class="as-eyebrow">Your library</p>
        <h2>Right where you left it.</h2>
        <p class="as-lede">
          Double-click your <code>.aplibrary</code> in Finder, or choose
          File ▸ Open Aperture Library. Alter reads it in place and builds its
          own catalog beside it. Nothing moves. Nothing is modified.
        </p>
      </div>

      <figure class="as-wide reveal">
        <img
          src={`${IMG}/library-aperture.webp`}
          alt="Alter’s browser showing an Aperture library: a grid of night and urban-exploration photos — a Futuro house, a ruined stone building, a lit downtown street, an old hotel — each with its filename, star rating and colour label. The sidebar lists Library items and a long list of Aperture projects with photo counts. The Futuro house is selected and the Adjust inspector on the right shows its White Balance, Exposure, Enhance and Highlights & Shadows bricks."
          width="1240"
          height="780"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="as-comes reveal">
        <h3>What comes across</h3>
        <ul class="as-checks">
          {comesAcross.map(([title, detail], i) => (
            <li style={`--i: ${i}`}>
              <span class="as-check" aria-hidden="true"></span>
              <span><strong>{title}</strong> {detail}</span>
            </li>
          ))}
        </ul>
        <p class="as-fine">
          Masters on other drives? Connect the drive first — Alter looks for
          each referenced master where Aperture last saw it.
        </p>
      </div>
    </section>

    <!-- ── Your edits ────────────────────────────────────────────────── -->
    <section class="as-section" id="edits">
      <div class="as-intro reveal">
        <p class="as-eyebrow">Your edits</p>
        <h2>Every adjustment came with you.</h2>
        <p class="as-lede">
          Exposure, levels, curves, colour, white balance, black &amp; white,
          vignettes, brushed-in adjustments, retouching, crops and
          straightening — Alter rebuilds each one from Aperture’s own recipe,
          so your photos still look the way you finished them. And they stay
          editable.
        </p>
      </div>

      <div class="as-wide reveal">
        <div class="as-compare" data-compare style="--pos: 50%">
          <img
            class="as-compare-after"
            data-compare-after
            src={`${IMG}/futuro-alter.webp`}
            alt="The Futuro house with its Aperture edit, rendered by Alter: a deep blue night sky, the saucer’s rusted shell glowing orange, its windows lit pale green and violet."
            width="1800"
            height="1200"
            loading="lazy"
            decoding="async"
          />
          <img
            class="as-compare-before"
            src={`${IMG}/futuro-as-shot.webp`}
            alt="The same Futuro house as shot, before any adjustment: flatter, browner and brighter, with a hazy grey-green sky."
            width="1800"
            height="1200"
            loading="lazy"
            decoding="async"
          />
          <span class="as-compare-tag as-compare-tag-left" aria-hidden="true">As shot</span>
          <span class="as-compare-tag as-compare-tag-right" aria-hidden="true" data-compare-label>Your edit, in Alter</span>
          <span class="as-compare-line" aria-hidden="true"><span></span></span>
          <input
            class="as-compare-range"
            type="range"
            min="0"
            max="100"
            value="50"
            aria-label="Drag to compare the master as shot with the edited photo"
          />
        </div>
        <div class="as-seg" role="group" aria-label="Right-hand side shows">
          <button type="button" aria-pressed="true" data-compare-src={`${IMG}/futuro-alter.webp`} data-compare-name="Your edit, in Alter">
            Rendered by Alter
          </button>
          <button type="button" aria-pressed="false" data-compare-src={`${IMG}/futuro-aperture.webp`} data-compare-name="Aperture’s own preview">
            Aperture’s own preview
          </button>
        </div>
        <p class="as-caption">
          Drag across the photo. Switch the right-hand side to Aperture’s own
          preview and back — in Alter, that comparison is one click on the
          Compare badge.
        </p>
      </div>
    </section>

    <!-- ── Bricks ─────────────────────────────────────────────────────── -->
    <!-- ── What's new ─────────────────────────────────────────────────── -->
    <section class="as-section" id="new">
      <div class="as-intro reveal">
        <p class="as-eyebrow">What’s new</p>
        <h2>The rest of Aperture, now in Alter.</h2>
        <p class="as-lede">
          Faces. Places. Print. An Import window that knows your cards and
          cameras, and tethered shooting. The things you reached for in
          Aperture and missed — free, like the rest of what Aperture had.
        </p>
      </div>

      <figure class="as-wide reveal">
        <img
          src="/images/alter/new/places.webp"
          alt="Alter’s Places view: a map of Texas with photo thumbnails pinned where they were taken — groups near Dallas, Wichita Falls and Texarkana with counts on them, single photos near El Paso, Abilene and Houston. Under the map, the browser shows the photos in view: night shots of a Futuro house, motel signs, rusted machinery and an old textile mill."
          width="2400"
          height="1826"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="as-org as-new reveal">
        <article class="as-org-card">
          <h3>Faces</h3>
          <p>Alter finds the faces in your library and groups the ones that look alike. Name a group in one go, then confirm what it suggests — Aperture’s Name tool and corkboard, back. Recognition runs on your Mac; no face ever leaves it.</p>
        </article>
        <article class="as-org-card">
          <h3>Places</h3>
          <p>Your whole library on a map, gathered into pins that split as you zoom. Drag photos onto the map to place them, search for somewhere, or lay a GPS track over a shoot and every photo lands where it was taken — with place names to search by.</p>
        </article>
        <article class="as-org-card">
          <h3>Print</h3>
          <p>Standard, contact sheets and review sheets with names and stars, 4×6 to 8×10 and wallets, and presets of your own — with a live preview that is the print. No printer? Save it as a PDF.</p>
        </article>
        <article class="as-org-card">
          <h3>Import &amp; tethering</h3>
          <p>Cards, cameras and folders in one window: rename as you copy, file into a project or a project per day, stamp creator and keywords, skip what’s already in. Tether a Canon or Sony and every shot lands in the library as you take it.</p>
        </article>
        <article class="as-org-card">
          <h3>Filter &amp; dates</h3>
          <p>The Filter HUD narrows any view by rating, keyword, camera, person or place. Adjust Date &amp; Time fixes a camera that was set to the wrong zone — in the library, and in the files if you like.</p>
        </article>
        <article class="as-org-card">
          <h3>And the small things</h3>
          <p>Metadata presets. The Mac’s Share menu. A Secondary Viewer for your other display. Detect Edges for brushes. Promote and demote in stacks, and Aperture’s own keys for them.</p>
        </article>
      </div>
    </section>

    <section class="as-section" id="bricks">
      <div class="as-intro reveal">
        <p class="as-eyebrow">The tools</p>
        <h2>The bricks you know. Every one.</h2>
        <p class="as-lede">
          Adjustments stack as bricks, each with a checkbox, a gear and a reset
          arrow — White Balance, Exposure, Enhance, Highlights &amp; Shadows,
          Levels, Curves, Color, Black &amp; White, Vignette and more. Brush any
          of them in or away. Try a few:
        </p>
      </div>

      <div class="as-wide as-bricks-demo reveal" data-bricks>
        <div class="as-bricks-photo">
          <img
            src={`${IMG}/poolhall-as-shot.webp`}
            alt="A small-town main street as shot: a row of old brick storefronts with awnings, one sign reading Pool Hall, under a blue sky with white clouds. Moving the sliders beside it changes how it looks."
            width="1600"
            height="1067"
            loading="lazy"
            decoding="async"
          />
          <span class="as-bricks-vignette" aria-hidden="true"></span>
        </div>

        <div class="as-inspector" aria-label="Adjust inspector demo">
          <details class="as-brick" open>
            <summary>
              <input type="checkbox" checked data-brick="exposure" aria-label="Exposure brick on" />
              <span>Exposure</span>
            </summary>
            <label class="as-slider">
              <span>Exposure</span>
              <input type="range" min="-2" max="2" step="0.01" value="0.35" data-adj="exposure" />
              <output>+0.35</output>
            </label>
            <label class="as-slider">
              <span>Brightness</span>
              <input type="range" min="-0.5" max="0.5" step="0.01" value="0" data-adj="brightness" />
              <output>0.00</output>
            </label>
          </details>
          <details class="as-brick" open>
            <summary>
              <input type="checkbox" checked data-brick="enhance" aria-label="Enhance brick on" />
              <span>Enhance</span>
            </summary>
            <label class="as-slider">
              <span>Contrast</span>
              <input type="range" min="-1" max="1" step="0.01" value="0.2" data-adj="contrast" />
              <output>+0.20</output>
            </label>
            <label class="as-slider">
              <span>Saturation</span>
              <input type="range" min="0" max="2" step="0.01" value="1.15" data-adj="saturation" />
              <output>1.15</output>
            </label>
          </details>
          <details class="as-brick">
            <summary>
              <input type="checkbox" data-brick="bw" aria-label="Black & White brick on" />
              <span>Black &amp; White</span>
            </summary>
            <label class="as-slider">
              <span>Tone</span>
              <input type="range" min="0" max="1" step="0.01" value="0.25" data-adj="sepia" />
              <output>0.25</output>
            </label>
          </details>
          <details class="as-brick">
            <summary>
              <input type="checkbox" data-brick="vignette" aria-label="Vignette brick on" />
              <span>Vignette</span>
            </summary>
            <label class="as-slider">
              <span>Intensity</span>
              <input type="range" min="0" max="1" step="0.01" value="0.6" data-adj="vignette" />
              <output>0.60</output>
            </label>
          </details>
          <p class="as-inspector-note">
            A browser sketch of the idea. Alter renders every brick with Core
            Image on the full-resolution file.
          </p>
        </div>
      </div>

      <ul class="as-chips reveal" aria-label="More tools">
        <li>Levels &amp; Curves, with eyedroppers</li>
        <li>Color, by hue</li>
        <li>Brush In / Brush Away, with Detect Edges</li>
        <li>Quick Brushes</li>
        <li>Straighten <kbd>G</kbd></li>
        <li>Crop <kbd>C</kbd></li>
        <li>Retouch <kbd>X</kbd></li>
        <li>Red Eye <kbd>E</kbd></li>
        <li>Lift &amp; Stamp <kbd>O</kbd></li>
        <li>Presets</li>
        <li>Auto on five bricks</li>
        <li>Chromatic Aberration</li>
        <li>Edit With… your other apps</li>
      </ul>
    </section>

    <!-- ── Select ──────────────────────────────────────────────────────── -->
    <section class="as-section" id="select">
      <div class="as-intro reveal">
        <p class="as-eyebrow">Select · S</p>
        <h2>Point at it. Alter selects it.</h2>
        <p class="as-lede">
          Click the sky, a wall, a window — Alter finds its edges with Segment
          Anything, running on your Mac, and you adjust just that, or
          everything but it. This photo has <em>six things hidden in it</em>.
          Move over it to find them, click one to select it, then try the
          bricks.
        </p>
      </div>

      <div class="as-wide as-select-demo reveal" data-select>
        <div class="as-select-photo">
          <div class="as-select-stage" data-select-stage>
            <img
              class="as-select-base"
              data-select-base
              src={`${IMG}/bigbend-alter.webp`}
              alt="An abandoned adobe building in the Texas desert under a grey sky: whitewashed walls crumbling to brick, dark window openings, a pile of rocks at its base, sand and scrub around it, and a red clay hill behind. Selecting parts of it and moving the sliders beside it changes just those parts."
              width="2928"
              height="1951"
              loading="lazy"
              decoding="async"
            />
            <img
              class="as-select-layer"
              data-select-layer
              src={`${IMG}/bigbend-alter.webp`}
              alt=""
              aria-hidden="true"
              width="2928"
              height="1951"
              loading="lazy"
              decoding="async"
            />
            <canvas class="as-select-outline" data-select-outline aria-hidden="true"></canvas>
            <p class="as-select-hint" data-select-hint aria-hidden="true">Move over the photo</p>
          </div>
        </div>

        <div class="as-inspector" aria-label="Select demo">
          <div class="as-select-found">
            <p class="as-select-score" aria-live="polite"><span data-select-count>0</span> of 6 found</p>
            <ul class="as-select-list">
              {selectObjects.map((o, i) => (
                <li>
                  <button type="button" data-select-object={o.id} aria-label={`Select ${o.name.toLowerCase()}`}>
                    <span class="as-select-q" aria-hidden="true">{i + 1}</span>
                    <span class="as-select-name">{o.name}</span>
                  </button>
                </li>
              ))}
            </ul>
          </div>
          <details class="as-brick" open>
            <summary><span>Adjust the selection</span></summary>
            <label class="as-slider">
              <span>Exposure</span>
              <input type="range" min="-1" max="1" step="0.01" value="0.4" data-sel-adj="exposure" disabled />
              <output>+0.40</output>
            </label>
            <label class="as-slider">
              <span>Saturation</span>
              <input type="range" min="0" max="2" step="0.01" value="1.4" data-sel-adj="saturation" disabled />
