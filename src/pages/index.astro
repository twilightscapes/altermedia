<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ── Reveal-on-scroll ────────────────────────────────────────────────
  // CSS handles the animation; this only flips the class. Anything already
  // on screen at load reveals immediately, so the hero never sits blank.
  const targets = document.querySelectorAll<HTMLElement>('.reveal');
  if (!reduceMotion) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-in');
          io.unobserve(entry.target);
        }
      },
      // threshold 0: tall sections can never reach a large visible ratio.
      { rootMargin: '0px 0px -8% 0px', threshold: 0 }
    );
    targets.forEach((el) => io.observe(el));
  } else {
    targets.forEach((el) => el.classList.add('is-in'));
  }

  // Opening a collapsed chapter brings its heading to a comfortable reading
  // position rather than leaving it pinned under the sticky nav.
  // Only for a person opening it: chapters that start open fire 'toggle' on
  // load too, and scrolling to those would yank the page down on arrival.
  document.querySelectorAll<HTMLDetailsElement>('.as-chapter').forEach((d) => {
    let byPerson = false;
    d.querySelector('summary')?.addEventListener('click', () => (byPerson = true));
    d.addEventListener('toggle', () => {
      const wanted = byPerson;
      byPerson = false;
      if (!d.open || !wanted) return;
      const top = d.getBoundingClientRect().top;
      if (top < 80 || top > window.innerHeight * 0.72) {
        d.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'center' });
      }
    });
  });

  // ── Copy build steps ────────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const src = document.querySelector(btn.dataset.copy!);
      if (!src) return;
      try {
        await navigator.clipboard.writeText(src.textContent ?? '');
        btn.textContent = 'Copied';
      } catch {
        btn.textContent = 'Select and copy';
      }
      setTimeout(() => (btn.textContent = 'Copy'), 1800);
    });
  });

  // ── Before / after ──────────────────────────────────────────────────
  const compare = document.querySelector<HTMLElement>('[data-compare]');
  if (compare) {
    const range = compare.querySelector<HTMLInputElement>('input[type=range]')!;
    const after = compare.querySelector<HTMLImageElement>('[data-compare-after]')!;
    const label = compare.querySelector<HTMLElement>('[data-compare-label]')!;
    const setPos = (v: number) => compare.style.setProperty('--pos', `${v}%`);
    range.addEventListener('input', () => setPos(Number(range.value)));

    // With a mouse, hovering moves the line too — no need to grab it.
    compare.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      const r = compare.getBoundingClientRect();
      const v = Math.max(0, Math.min(100, ((e.clientX - r.left) / r.width) * 100));
      range.value = String(v);
      setPos(v);
    });

    const alts: Record<string, string> = {
      alter: after.alt,
      aperture:
        'The Futuro house as Aperture itself rendered the edit, from the preview saved in the library: a blue night sky, the saucer’s shell glowing orange, its windows pale green and violet.',
    };
    const buttons = compare.parentElement!.querySelectorAll<HTMLButtonElement>('[data-compare-src]');
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        after.src = b.dataset.compareSrc!;
        label.textContent = b.dataset.compareName!;
        after.alt = b.dataset.compareSrc!.includes('aperture.webp') ? alts.aperture : alts.alter;
      })
    );
  }

  // ── Bricks ──────────────────────────────────────────────────────────
  const bricks = document.querySelector<HTMLElement>('[data-bricks]');
  if (bricks) {
    const photo = bricks.querySelector<HTMLElement>('.as-bricks-photo')!;
    const val = (name: string) =>
      Number(bricks.querySelector<HTMLInputElement>(`[data-adj="${name}"]`)!.value);
    const on = (name: string) =>
      bricks.querySelector<HTMLInputElement>(`[data-brick="${name}"]`)!.checked;
    const fmt = (n: number, signed: boolean) => (signed && n > 0 ? '+' : '') + n.toFixed(2);

    const render = () => {
      const f: string[] = [];
      if (on('exposure')) {
        f.push(`brightness(${(Math.pow(2, val('exposure') * 0.55) + val('brightness')).toFixed(3)})`);
      }
      if (on('enhance')) {
        f.push(`contrast(${(1 + val('contrast') * 0.6).toFixed(3)})`);
        f.push(`saturate(${val('saturation').toFixed(3)})`);
      }
      if (on('bw')) {
        f.push('grayscale(1)');
        f.push(`sepia(${val('sepia').toFixed(3)})`);
      }
      photo.style.setProperty('--photo-filter', f.length ? f.join(' ') : 'none');
      photo.style.setProperty('--vignette', on('vignette') ? String(val('vignette')) : '0');
    };

    bricks.querySelectorAll<HTMLInputElement>('input[type=range]').forEach((r) => {
      const out = r.parentElement!.querySelector('output')!;
      const signed = Number(r.min) < 0;
      r.addEventListener('input', () => {
        out.textContent = fmt(Number(r.value), signed);
        render();
      });
    });
    bricks.querySelectorAll<HTMLInputElement>('input[type=checkbox]').forEach((c) => {
      // The checkbox lives in the summary: ticking it shouldn't also fold the brick.
      c.addEventListener('click', (e) => e.stopPropagation());
      c.addEventListener('change', render);
    });
    render();
  }

  // ── Loupe ───────────────────────────────────────────────────────────
  const loupeStage = document.querySelector<HTMLElement>('[data-loupe]');
  if (loupeStage) {
    const img = loupeStage.querySelector<HTMLImageElement>('img')!;
    const lens = loupeStage.querySelector<HTMLElement>('[data-loupe-lens]')!;
    const rgb = loupeStage.querySelector<HTMLElement>('[data-loupe-rgb]')!;
    const zoomButtons = loupeStage.parentElement!.querySelectorAll<HTMLButtonElement>('[data-zoom]');
    let zoom = 2;
    // Where the loupe sits, as fractions of the photo, so resizes keep the spot.
    let px = 0.6, py = 0.45;
    let sampler: CanvasRenderingContext2D | null = null;
    let samplerTried = false;

    const ensureSampler = () => {
      if (samplerTried || !img.complete || !img.naturalWidth) return;
      samplerTried = true;
      try {
        const c = document.createElement('canvas');
        c.width = img.naturalWidth;
        c.height = img.naturalHeight;
        const ctx = c.getContext('2d', { willReadFrequently: true });
        if (!ctx) return;
        ctx.drawImage(img, 0, 0);
        ctx.getImageData(0, 0, 1, 1); // throws if the canvas is tainted
        sampler = ctx;
      } catch {
        sampler = null;
      }
    };

    const draw = () => {
      const w = img.clientWidth, h = img.clientHeight;
      const nw = img.naturalWidth || 2928, nh = img.naturalHeight || 1951;
      const inner = lens.clientWidth; // inside the rim
      lens.style.transform = `translate(${px * w}px, ${py * h}px)`;

      // 100% = one photo pixel per CSS pixel. Centre the lens on the photo
      // pixel under its middle.
      const bw = nw * zoom, bh = nh * zoom;
      const ox = inner / 2 - px * bw, oy = inner / 2 - py * bh;
      const layers = [`url("${img.currentSrc || img.src}")`];
      const sizes = [`${bw}px ${bh}px`];
      const positions = [`${ox}px ${oy}px`];
      if (zoom >= 8) {
        // Pixel grid, aligned to the photo's pixel boundaries.
        const g = 'rgba(0,0,0,0.35)';
        layers.unshift(
          `linear-gradient(to right, ${g} 1px, transparent 1px)`,
          `linear-gradient(to bottom, ${g} 1px, transparent 1px)`
        );
        sizes.unshift(`${zoom}px ${zoom}px`, `${zoom}px ${zoom}px`);
        positions.unshift(`${ox}px ${oy}px`, `${ox}px ${oy}px`);
      }
      lens.style.backgroundImage = layers.join(', ');
      lens.style.backgroundSize = sizes.join(', ');
      lens.style.backgroundPosition = positions.join(', ');
      lens.style.backgroundRepeat = zoom >= 8 ? 'repeat, repeat, no-repeat' : 'no-repeat';
      lens.style.imageRendering = zoom >= 4 ? 'pixelated' : 'auto';

      ensureSampler();
      if (sampler) {
        const sx = Math.min(nw - 1, Math.max(0, Math.floor(px * nw)));
        const sy = Math.min(nh - 1, Math.max(0, Math.floor(py * nh)));
        const [r, g, b] = sampler.getImageData(sx, sy, 1, 1).data;
        rgb.textContent = `${Math.round(zoom * 100)}%   R ${r}  G ${g}  B ${b}`;
      } else {
        rgb.textContent = `${Math.round(zoom * 100)}%`;
      }
      lens.setAttribute('aria-label', `Loupe at ${Math.round(zoom * 100)}% — use the arrow keys to move it`);
    };

    const moveTo = (clientX: number, clientY: number) => {
      const r = img.getBoundingClientRect();
      px = Math.max(0, Math.min(1, (clientX - r.left) / r.width));
      py = Math.max(0, Math.min(1, (clientY - r.top) / r.height));
      draw();
    };

    // Mouse: the loupe follows the pointer.
    loupeStage.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'mouse') moveTo(e.clientX, e.clientY);
    });
    // Touch and pen: drag the lens itself (the page still scrolls elsewhere).
    let dragging = false;
    lens.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse') return;
      dragging = true;
      lens.setPointerCapture(e.pointerId);
    });
    lens.addEventListener('pointermove', (e) => {
      if (dragging) moveTo(e.clientX, e.clientY);
    });
    const stop = () => (dragging = false);
    lens.addEventListener('pointerup', stop);
    lens.addEventListener('pointercancel', stop);

    lens.addEventListener('keydown', (e) => {
      const step = e.shiftKey ? 0.05 : 0.01;
      const moves: Record<string, [number, number]> = {
        ArrowLeft: [-step, 0], ArrowRight: [step, 0], ArrowUp: [0, -step], ArrowDown: [0, step],
      };
      const m = moves[e.key];
      if (!m) return;
      e.preventDefault();
      px = Math.max(0, Math.min(1, px + m[0]));
      py = Math.max(0, Math.min(1, py + m[1]));
      draw();
    });

    zoomButtons.forEach((b) =>
      b.addEventListener('click', () => {
        zoom = Number(b.dataset.zoom);
        zoomButtons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        draw();
      })
    );

    if (img.complete) draw();
    img.addEventListener('load', draw);
    window.addEventListener('resize', draw);
  }

  // ── Keys ────────────────────────────────────────────────────────────
  const keysDemo = document.querySelector<HTMLElement>('[data-keys]');
  if (keysDemo) {
    const stage = keysDemo.querySelector<HTMLElement>('[data-keys-stage]')!;
    const img = keysDemo.querySelector<HTMLImageElement>('[data-keys-img]')!;
    const stars = keysDemo.querySelector<HTMLElement>('[data-keys-stars]')!;
    const status = keysDemo.querySelector<HTMLElement>('[data-keys-status]')!;
    const hudRating = keysDemo.querySelector<HTMLElement>('[data-keys-hud-rating]')!;
    const caps = new Map<string, HTMLButtonElement>();
    keysDemo.querySelectorAll<HTMLButtonElement>('[data-key]').forEach((b) => caps.set(b.dataset.key!, b));

    // Preload the master so M swaps instantly.
    new Image().src = img.dataset.master!;

    let rating = 0;
    const set = (name: string, value: boolean) =>
      value ? stage.setAttribute(`data-${name}`, '') : stage.removeAttribute(`data-${name}`);
    const has = (name: string) => stage.hasAttribute(`data-${name}`);
    const say = (text: string) => (status.textContent = text);
    const showRating = () => {
      stars.textContent = '★'.repeat(rating);
      hudRating.textContent = rating ? `${'★'.repeat(rating)}` : 'No rating';
    };

    const press = (key: string) => {
      const cap = caps.get(key);
      if (cap) {
        cap.classList.add('is-down');
        setTimeout(() => cap.classList.remove('is-down'), 140);
      }
      switch (key) {
        case '1': case '2': case '3': case '4': case '5':
          rating = Number(key);
          set('reject', false);
          showRating();
          say(`Rated ${rating} star${rating > 1 ? 's' : ''}.`);
          break;
        case '0':
          rating = 0;
          set('reject', false);
          showRating();
          say('Rating cleared.');
          break;
        case '9':
          rating = 0;
          showRating();
          set('reject', !has('reject'));
          say(has('reject') ? 'Rejected.' : 'No longer rejected.');
          break;
        case '/':
          set('flag', !has('flag'));
          say(has('flag') ? 'Flagged.' : 'Unflagged.');
          break;
        case 'm':
          set('master', !has('master'));
          img.src = has('master') ? img.dataset.master! : img.dataset.edit!;
          say(has('master') ? 'Showing the master, as shot. M again for your edit.' : 'Back to your edit.');
          break;
        case 'z':
          set('zoom', !has('zoom'));
          say(has('zoom') ? 'Zoomed to 100%.' : 'Zoomed to fit.');
          break;
        case 'f':
          set('full', !has('full'));
          if (!has('full')) set('hud', false);
          say(has('full') ? 'Full Screen. Try H for the Inspector HUD, Esc to leave.' : 'Left Full Screen.');
          break;
        case 'h':
          if (!has('full')) {
            say('H brings up the Inspector HUD in Full Screen. Press F first.');
            break;
          }
          set('hud', !has('hud'));
          say(has('hud') ? 'Inspector HUD.' : 'HUD hidden.');
          break;
        case 'escape':
          if (has('full')) {
            set('full', false);
            set('hud', false);
            say('Left Full Screen.');
          }
          break;
      }
    };

    caps.forEach((b, key) => b.addEventListener('click', () => press(key)));
    // In Full Screen the on-screen keys are hidden behind the stage; a click
    // on the black leaves it, as a tap would expect.
    stage.addEventListener('click', (e) => {
      if (has('full') && e.target === stage) press('escape');
    });

    // Real keys work while the demo is on screen and you're not typing.
    let inView = false;
    new IntersectionObserver(
      (entries) => {
        inView = entries.some((e) => e.isIntersecting);
      },
      { threshold: 0.35 }
    ).observe(keysDemo);

    document.addEventListener('keydown', (e) => {
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      const t = e.target instanceof Element ? e.target : null;
      if (t?.closest('input, textarea, select, [contenteditable]')) return;
      const key = e.key.toLowerCase();
      if (!(inView || has('full'))) return;
      if (key === 'escape' ? has('full') : caps.has(key)) {
        e.preventDefault();
        press(key);
      }
    });
  }

  // ── Stack ───────────────────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('[data-stack]').forEach((b) =>
    b.addEventListener('click', () =>
      b.setAttribute('aria-expanded', String(b.getAttribute('aria-expanded') !== 'true'))
    )
  );

  // ── Select: six real selections hidden in a photo ─────────────────────
  const selectDemo = document.querySelector<HTMLElement>('[data-select]');
  if (selectDemo) {
    const stage = selectDemo.querySelector<HTMLElement>('[data-select-stage]')!;
    const base = selectDemo.querySelector<HTMLImageElement>('[data-select-base]')!;
    const layer = selectDemo.querySelector<HTMLImageElement>('[data-select-layer]')!;
    const canvas = selectDemo.querySelector<HTMLCanvasElement>('[data-select-outline]')!;
    const hint = selectDemo.querySelector<HTMLElement>('[data-select-hint]')!;
    const countEl = selectDemo.querySelector<HTMLElement>('[data-select-count]')!;
    const note = selectDemo.querySelector<HTMLElement>('[data-select-note]')!;
    const buttons = new Map<string, HTMLButtonElement>();
    selectDemo.querySelectorAll<HTMLButtonElement>('[data-select-object]').forEach((b) =>
      buttons.set(b.dataset.selectObject!, b));
    const controls = selectDemo.querySelectorAll<HTMLInputElement>('[data-sel-adj]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const MASKS = '/images/alter/select';
    // No hover on a phone: tap to find.
    const touch = window.matchMedia('(hover: none)').matches;
    const idleHint = touch ? 'Tap around the photo' : 'Move over the photo';
    hint.textContent = idleHint;

    type Mask = { id: string; w: number; h: number; alpha: Uint8ClampedArray; area: number; edge: Int32Array };
    const masks = new Map<string, Mask>();
    const found = new Set<string>();
    let hovered: string | null = null;
    let selected: string | null = null;
    let raf = 0;

    // Each mask's alpha (for hit-testing) and its outline pixels.
    const load = (id: string) =>
      new Promise<void>((resolve) => {
        const img = new Image();
        img.onload = () => {
          const w = img.naturalWidth, h = img.naturalHeight;
          const c = document.createElement('canvas');
          c.width = w; c.height = h;
          const ctx = c.getContext('2d', { willReadFrequently: true })!;
          ctx.drawImage(img, 0, 0);
          const data = ctx.getImageData(0, 0, w, h).data;
          const alpha = new Uint8ClampedArray(w * h);
          let area = 0;
          for (let i = 0; i < w * h; i++) { alpha[i] = data[i * 4 + 3]; if (alpha[i] > 127) area++; }
          const edge: number[] = [];
          for (let y = 1; y < h - 1; y++) {
            for (let x = 1; x < w - 1; x++) {
              const i = y * w + x;
              if (alpha[i] <= 127) continue;
              if (alpha[i - 1] <= 127 || alpha[i + 1] <= 127 || alpha[i - w] <= 127 || alpha[i + w] <= 127) edge.push(i);
            }
          }
          masks.set(id, { id, w, h, alpha, area, edge: Int32Array.from(edge) });
          resolve();
        };
        img.onerror = () => resolve();
        img.src = `${MASKS}/${id}.webp`;
      });

    let loading: Promise<void> | null = null;
    const ensureLoaded = () => (loading ??= Promise.all([...buttons.keys()].map(load)).then(() => {}));
    // Start fetching when the demo comes near the screen.
    new IntersectionObserver((entries, obs) => {
      if (entries.some((e) => e.isIntersecting)) { ensureLoaded(); obs.disconnect(); }
    }, { rootMargin: '400px' }).observe(selectDemo);

    // What's under a point: the smallest thing there (a window over its wall).
    const hit = (clientX: number, clientY: number): string | null => {
      const r = stage.getBoundingClientRect();
      const nx = (clientX - r.left) / r.width, ny = (clientY - r.top) / r.height;
      if (nx < 0 || ny < 0 || nx > 1 || ny > 1) return null;
      let best: Mask | null = null;
      for (const m of masks.values()) {
        const a = m.alpha[Math.min(m.h - 1, Math.floor(ny * m.h)) * m.w + Math.min(m.w - 1, Math.floor(nx * m.w))];
        if (a > 127 && (!best || m.area < best.area)) best = m;
      }
      return best?.id ?? null;
    };

    const draw = (t = 0) => {
      const r = stage.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;
      const W = Math.round(r.width * dpr), H = Math.round(r.height * dpr);
      if (canvas.width !== W || canvas.height !== H) { canvas.width = W; canvas.height = H; }
      const ctx = canvas.getContext('2d')!;
      ctx.clearRect(0, 0, W, H);
      const paint = (m: Mask, style: 'hover' | 'ants') => {
        const sx = W / m.w, sy = H / m.h, dot = Math.max(1.5, sx * 1.2);
        const phase = Math.floor(t / 90);
        for (let k = 0; k < m.edge.length; k++) {
          const i = m.edge[k], x = i % m.w, y = (i / m.w) | 0;
          if (style === 'ants') {
            ctx.fillStyle = (((x + y) >> 2) + phase) & 1 ? '#ffffff' : '#111111';
          }
          ctx.fillRect(x * sx, y * sy, dot, dot);
        }
      };
      if (hovered && hovered !== selected) {
        const m = masks.get(hovered);
        if (m) {
          ctx.fillStyle = 'rgba(255, 255, 255, 0.85)';
          ctx.shadowColor = 'rgba(111, 155, 255, 0.9)';
          ctx.shadowBlur = 6 * dpr;
          paint(m, 'hover');
          ctx.shadowBlur = 0;
        }
      }
      if (selected) {
        const m = masks.get(selected);
        if (m) paint(m, 'ants');
      }
    };

    const animate = (t: number) => {
      draw(t);
      raf = selected && !reduceMotion ? requestAnimationFrame(animate) : 0;
    };
    const redraw = () => {
      if (raf) return; // the animation is already drawing
      if (selected && !reduceMotion) raf = requestAnimationFrame(animate);
      else draw();
    };

    const applyLook = () => {
      const v = (name: string) => selectDemo.querySelector<HTMLInputElement>(`[data-sel-adj="${name}"]`)!;
      const exposure = Number(v('exposure').value), sat = Number(v('saturation').value);
      const warmth = Number(v('warmth').value), blur = Number(v('blur').value);
      const bw = v('bw').checked, invert = v('invert').checked;
      const look = `brightness(${(1 + exposure * 0.7).toFixed(3)}) saturate(${sat.toFixed(2)}) ` +
        `sepia(${(warmth * 0.45).toFixed(2)}) grayscale(${bw ? 1 : 0}) blur(${blur.toFixed(1)}px)`;
      if (!selected) {
        stage.style.setProperty('--base-filter', 'none');
        layer.classList.remove('is-on');
        return;
      }
      // Inverted: the photo takes the look and the selection, untouched,
      // sits on top of it.
      stage.style.setProperty('--base-filter', invert ? look : 'none');
      stage.style.setProperty('--layer-filter', invert ? 'none' : look);
      const url = `url(${MASKS}/${selected}.webp)`;
      layer.style.setProperty('mask-image', url);
      layer.style.setProperty('-webkit-mask-image', url);
      layer.classList.add('is-on');
    };

    const select = (id: string | null) => {
      selected = id;
      for (const [key, b] of buttons) b.classList.toggle('is-current', key === id);
      controls.forEach((c) => (c.disabled = !id));
      if (id && !found.has(id)) {
        found.add(id);
        buttons.get(id)!.classList.add('is-found');
        countEl.textContent = String(found.size);
        if (found.size === buttons.size) {
          note.textContent = 'All six — that’s Select. In Alter it works on any photo, on your Mac: click, adjust, done.';
        }
      }
      hint.classList.toggle('is-gone', !!id);
      if (id) hint.textContent = 'Now try the bricks';
      applyLook();
      if (raf) { cancelAnimationFrame(raf); raf = 0; }
      redraw();
    };

    stage.addEventListener('pointermove', (e) => {
      if (!masks.size) { ensureLoaded(); return; }
      const id = hit(e.clientX, e.clientY);
      if (id !== hovered) {
        hovered = id;
        if (!selected) {
          hint.textContent = id ? (found.has(id) ? 'Click to select it again' : 'Found something — click it') : idleHint;
          hint.classList.remove('is-gone');
        }
        redraw();
      }
    });
    stage.addEventListener('pointerleave', () => { hovered = null; redraw(); });
    stage.addEventListener('click', async (e) => {
      await ensureLoaded();
      const id = hit(e.clientX, e.clientY);
      select(id && id === selected ? null : id);
    });
    for (const [id, b] of buttons) {
      b.addEventListener('click', async () => {
        await ensureLoaded();
        select(id === selected ? null : id);
      });
    }
    controls.forEach((c) => {
      const out = c.parentElement!.querySelector('output');
      c.addEventListener('input', () => {
        if (out) {
          const n = Number(c.value);
          out.textContent = c.dataset.selAdj === 'exposure' ? (n >= 0 ? '+' : '') + n.toFixed(2)
            : c.dataset.selAdj === 'blur' ? n.toFixed(1) : n.toFixed(2);
        }
        applyLook();
      });
    });
    window.addEventListener('resize', () => redraw());
  }
</script>
