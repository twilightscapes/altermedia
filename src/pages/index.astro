        <article class="as-org-card">
          <h3>Smart albums</h3>
          <div class="as-rules" aria-label="Example smart album rules">
            <div><span>Lens</span><span>contains</span><span class="as-rule-val">16-35</span></div>
            <div><span>Rating</span><span>is at least</span><span class="as-rule-val">★★★</span></div>
            <div><span>ISO</span><span>is greater than</span><span class="as-rule-val">1600</span></div>
          </div>
