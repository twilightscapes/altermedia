        </a>
        <a class="as-btn as-btn-quiet" href={SOURCE_URL}>Read the source</a>
      </p>
      <p class="as-fine">
        Aperture is a trademark of Apple Inc. Alter is not affiliated with or
        endorsed by Apple.
      </p>
    </section>
  </div>
</AlterBase>

<!--
  Dark-only. global.css repaints its tokens under prefers-color-scheme: light,
  which would flip this page (and the shared nav/footer) to a light theme on a
  Mac set to Light. Re-pin the tokens here so the whole page stays dark
  regardless of system setting. Page-scoped: no other route imports this.
-->
<style is:global>
  html:root,
  html:root body {
    --bg: #08090c;
    --surface: #101318;
    --surface-2: #171b22;
    --border: #262c36;
    --text: #edf1f6;
    --muted: #98a2b1;
    --accent: #6f9bff;
    --accent-strong: #4f7ce8;
    color-scheme: dark;
  }
  html:root body { overflow-x: clip; }
</style>

<style>
  /* ── Page tokens ───────────────────────────────────────────────────── */
  .as {
    --as-max: 1080px;
    --as-wide: 1320px;
    --as-text: #edf1f6;
    --as-muted: #98a2b1;
    --as-dim: #6f7987;
    --as-accent: #6f9bff;
    --as-violet: #a77dff;
    --as-good: #4fd18b;
    --as-amber: #f5b544;
    --as-line: #262c36;
    --as-panel: #101318;
    --as-panel-2: #161a21;

    max-width: var(--as-max);
    margin: 0 auto;
    padding: 0 24px 120px;
    color: var(--as-text);
  }

  .as :is(h1, h2, h3) {
    letter-spacing: -0.035em;
    line-height: 1.05;
    margin: 0;
    text-wrap: balance;
  }

  .as-lede {
    color: var(--as-muted);
    font-size: 1.2rem;
    line-height: 1.6;
    max-width: 62ch;
    text-wrap: pretty;
  }
  .as-lede em { color: var(--as-text); font-style: italic; }
  .as :is(.as-lede, .as-chapter-body) code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.86em;
    color: var(--as-text);
    background: var(--as-panel-2);
    border: 1px solid var(--as-line);
    border-radius: 6px;
    padding: 1px 6px;
  }

  .as-fine {
    color: var(--as-dim);
    font-size: 0.85rem;
    margin-top: 14px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* Wider than the text column — the big highlights. */
  /* Centred with margins, not a transform: a transformed ancestor would
     trap the keys demo's position: fixed Full Screen inside it. */
  .as-wide {
    --w: min(var(--as-wide), calc(100vw - 32px));
    width: var(--w);
    margin: 0 0 0 calc((100% - var(--w)) / 2);
  }
  .as-wide > img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 20px;
    border: 1px solid var(--as-line);
    box-shadow: 0 40px 120px rgba(0, 0, 0, 0.6);
  }

  /* ── Hero ──────────────────────────────────────────────────────────── */
  .as-hero {
    text-align: center;
    padding: 64px 0 48px;
  }
  /* The PNG has transparent padding around its tile, so the glow follows
     the tile's alpha (drop-shadow) — a box-shadow lit up the padding and
     left a dark square around the icon. */
  .as-appicon {
    filter: drop-shadow(0 16px 36px rgba(110, 90, 240, 0.45));
  }
  .as-brand {
    width: 128px;
    margin: 0 auto;
  }
  .as-brand .as-appicon { display: block; }
  .as-wordmark {
    display: block;
    width: calc(100% * 824 / 1024);
    height: auto;
    margin: 6px auto 0;
    overflow: visible;
  }
  .as-wordmark text {
    fill: var(--as-text);
    font-family: var(--font);
    font-size: 386px;
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .as-hero .as-eyebrow-hero { margin: 40px 0 14px; }
  .as-hero h1 {
    font-size: clamp(3.2rem, 10vw, 7rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.045em;
    margin: 0 0 26px;
    background: linear-gradient(135deg, #ffffff 20%, var(--as-accent) 65%, var(--as-violet));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .as-hero .as-lede { margin: 0 auto; }

  .as-hero-shot { margin-top: 8px; }

  .as-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin: 30px 0 0;
  }
  .as-btn {
    display: inline-block;
    background: var(--as-accent);
    color: #06080d;
    font-weight: 650;
    text-decoration: none;
    padding: 0.8rem 1.6rem;
    border-radius: 999px;
    border: 1px solid transparent;
    transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
  }
  .as-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(111, 155, 255, 0.3);
  }
  .as-btn-quiet {
    background: transparent;
    color: var(--as-text);
    border-color: var(--as-line);
  }
  .as-btn-quiet:hover { border-color: var(--as-accent); box-shadow: none; }
  .as-store { display: inline-flex; align-items: center; border-radius: 10px; }
  .as-store img { display: block; height: 52px; width: auto; }
  .as-store:focus-visible { outline: 2px solid var(--as-accent); outline-offset: 3px; }
  .as-direct a { color: inherit; }

  /* ── Jump nav ──────────────────────────────────────────────────────── */
  .as-jump {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    gap: 6px;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 12px 0;
    margin: 56px 0 8px;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(180%) blur(16px);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    border-bottom: 1px solid var(--as-line);
  }
  .as-jump::-webkit-scrollbar { display: none; }
  .as-jump a,
  .as-jump-inline a {
    flex: 0 0 auto;
    color: var(--as-muted);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 550;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    border: 1px solid transparent;
    white-space: nowrap;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .as-jump a:hover,
  .as-jump-inline a:hover {
    color: var(--as-text);
    background: var(--as-panel-2);
    border-color: var(--as-line);
  }
  .as-jump-inline {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .as-jump-inline a { border-color: var(--as-line); }

  /* ── Sections ──────────────────────────────────────────────────────── */
  .as-section {
    padding: 120px 0 24px;
    scroll-margin-top: 72px;
  }
  .as-intro { max-width: 66ch; margin-bottom: 40px; }
  .as-eyebrow {
    color: var(--as-accent);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 0 0 12px;
  }
  .as-section h2 {
    font-size: clamp(2.4rem, 6.4vw, 4.4rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    margin-bottom: 20px;
  }
  .as-caption {
    color: var(--as-dim);
    font-size: 0.92rem;
    text-align: center;
    margin: 18px auto 0;
    max-width: 62ch;
  }

  /* Segmented control (compare source, loupe zoom). */
  .as-seg {
    display: flex;
    justify-content: center;
    gap: 4px;
    width: fit-content;
    margin: 22px auto 0;
    padding: 4px;
    border-radius: 999px;
    background: var(--as-panel-2);
    border: 1px solid var(--as-line);
  }
  .as-seg button {
    font: inherit;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--as-muted);
    background: transparent;
    border: 0;
    border-radius: 999px;
    padding: 0.45rem 1rem;
    cursor: pointer;
  }
  .as-seg button[aria-pressed='true'] {
    color: #06080d;
    background: var(--as-accent);
  }
  .as-seg button:focus-visible { outline: 2px solid var(--as-accent); outline-offset: 2px; }

  /* ── Open source ───────────────────────────────────────────────────── */
  .as-open .as-intro { max-width: 70ch; }
  .as-open h2 {
    background: linear-gradient(135deg, #ffffff 30%, var(--as-good));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .as-timeline {
    list-style: none;
    margin: 0 0 56px;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
    position: relative;
  }
  .as-timeline::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 23px;
    height: 2px;
    background: linear-gradient(90deg, var(--as-line), #5a3b3b 45%, #5a3b3b 70%, var(--as-good));
    transform-origin: left;
    transform: scaleX(0);
    transition: transform 1.4s cubic-bezier(0.22, 1, 0.36, 1) 0.2s;
  }
  .as-timeline.is-in::before { transform: scaleX(1); }
  .as-timeline li {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-top: 44px;
    color: var(--as-muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .as-timeline li::before {
    content: '';
    position: absolute;
    top: 16px;
    left: 0;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--as-panel);
    border: 2px solid var(--as-dim);
  }
  .as-timeline li:nth-child(2)::before,
  .as-timeline li:nth-child(3)::before { border-color: #d0605e; }
  .as-timeline .as-tl-now::before {
    border-color: var(--as-good);
    background: var(--as-good);
    box-shadow: 0 0 0 6px rgba(79, 209, 139, 0.18);
  }
  .as-tl-year {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--as-dim);
  }
  .as-timeline strong {
    color: var(--as-text);
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }
  .as-tl-now strong { color: var(--as-good); }

  .as-pillars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }
  .as-pillar {
    border: 1px solid var(--as-line);
    border-radius: 20px;
    padding: 26px 24px 22px;
    background:
      radial-gradient(120% 100% at 0% 0%, rgba(79, 209, 139, 0.08), transparent 60%),
      var(--as-panel);
  }
  .as-pillar-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    font-weight: 800;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    color: var(--as-good);
    background: rgba(79, 209, 139, 0.12);
    margin-bottom: 18px;
  }
  .as-pillar h3 { font-size: 1.3rem; margin-bottom: 10px; }
  .as-pillar p { margin: 0; color: var(--as-muted); line-height: 1.6; }

  .as-terminal {
    margin-top: 28px;
    border: 1px solid var(--as-line);
    border-radius: 18px;
    overflow: hidden;
    background: #05070a;
  }
  .as-terminal-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 16px;
    background: var(--as-panel-2);
    border-bottom: 1px solid var(--as-line);
  }
  .as-dots { display: inline-flex; gap: 7px; }
  .as-dots i { width: 11px; height: 11px; border-radius: 50%; background: #3a404b; }
  .as-terminal-title { color: var(--as-muted); font-size: 0.85rem; font-weight: 600; flex: 1; }
  .as-copy {
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--as-text);
    background: transparent;
    border: 1px solid var(--as-line);
    border-radius: 999px;
    padding: 0.25rem 0.8rem;
    cursor: pointer;
  }
  .as-copy:hover { border-color: var(--as-accent); }
  .as-terminal pre {
    margin: 0;
    padding: 22px 22px 18px;
    overflow-x: auto;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.95rem;
    line-height: 1.8;
    color: #cfe9d9;
  }
  .as-terminal-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 18px;
    margin: 0;
    padding: 12px 22px 16px;
    font-size: 0.85rem;
    color: var(--as-dim);
    border-top: 1px solid var(--as-line);
  }
  .as-terminal-foot a { color: var(--as-good); font-weight: 600; text-decoration: none; }
  .as-terminal-foot a:hover { text-decoration: underline; }

  /* ── What comes across ─────────────────────────────────────────────── */
  .as-comes { margin-top: 56px; }
  .as-comes h3 { font-size: 1.5rem; margin-bottom: 18px; }
  .as-checks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px 32px;
  }
  .as-checks li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    color: var(--as-muted);
    line-height: 1.5;
  }
  .as-checks strong { color: var(--as-text); display: block; }
  .as-check {
    flex: 0 0 auto;
    position: relative;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 2px solid var(--as-line);
    margin-top: 1px;
    transition: background 0.3s ease, border-color 0.3s ease;
    transition-delay: calc(var(--i) * 140ms + 200ms);
  }
  .as-check::after {
    content: '';
    position: absolute;
    left: 7px;
    top: 3px;
    width: 6px;
    height: 11px;
    border-right: 2.5px solid #06080d;
    border-bottom: 2.5px solid #06080d;
    transform: rotate(45deg) scale(0);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    transition-delay: calc(var(--i) * 140ms + 260ms);
  }
  .as-comes.is-in .as-check { background: var(--as-good); border-color: var(--as-good); }
  .as-comes.is-in .as-check::after { transform: rotate(45deg) scale(1); }

  /* ── Compare slider ────────────────────────────────────────────────── */
  .as-compare {
    position: relative;
    aspect-ratio: 3 / 2;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid var(--as-line);
    box-shadow: 0 40px 120px rgba(0, 0, 0, 0.6);
    background: #000;
    user-select: none;
  }
  .as-compare img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .as-compare-before { clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  .as-compare-line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    margin-left: -1px;
    background: #fff;
    box-shadow: 0 0 12px rgba(0, 0, 0, 0.6);
    pointer-events: none;
  }
  .as-compare-line span {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 46px;
    height: 46px;
    margin: -23px 0 0 -23px;
    border-radius: 50%;
    background: rgba(8, 9, 12, 0.7);
    border: 2px solid #fff;
    backdrop-filter: blur(6px);
  }
  .as-compare-line span::before,
  .as-compare-line span::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 8px;
    height: 8px;
    margin-top: -4px;
    border-left: 2px solid #fff;
    border-bottom: 2px solid #fff;
  }
  .as-compare-line span::before { left: 11px; transform: rotate(45deg); }
  .as-compare-line span::after { right: 11px; transform: rotate(-135deg); }
  .as-compare-range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }
  .as-compare:has(.as-compare-range:focus-visible) {
    outline: 3px solid var(--as-accent);
    outline-offset: 4px;
  }
  .as-compare-tag {
    position: absolute;
    top: 18px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    background: rgba(8, 9, 12, 0.6);
    backdrop-filter: blur(8px);
    border-radius: 999px;
    padding: 6px 12px;
    pointer-events: none;
  }
  .as-compare-tag-left { left: 18px; }
  .as-compare-tag-right { right: 18px; }

  /* ── Bricks demo ───────────────────────────────────────────────────── */
  .as-bricks-demo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    border: 1px solid var(--as-line);
    border-radius: 20px;
    overflow: hidden;
    background: #1e2127;
    box-shadow: 0 40px 120px rgba(0, 0, 0, 0.6);
  }
  .as-bricks-photo {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #141518;
    padding: 18px;
  }
  .as-bricks-photo img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
    filter: var(--photo-filter, none);
  }
  .as-bricks-vignette {
    position: absolute;
    inset: 18px;
    border-radius: 4px;
    pointer-events: none;
    background: radial-gradient(ellipse at center, transparent 45%, rgba(0, 0, 0, 0.95) 100%);
    opacity: var(--vignette, 0);
  }
  .as-inspector {
    background: #2a2d33;
    border-left: 1px solid #16181c;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.85rem;
  }
  .as-brick {
    background: #33363d;
    border: 1px solid #1d1f23;
    border-radius: 8px;
  }
  .as-brick summary {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 9px 10px;
    cursor: pointer;
    list-style: none;
    font-weight: 650;
    color: #eceef2;
  }
  .as-brick summary::-webkit-details-marker { display: none; }
  .as-brick summary::before {
    content: '';
    width: 0;
    height: 0;
    border-left: 5px solid #9aa1ad;
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
    transition: transform 0.15s ease;
  }
  .as-brick[open] summary::before { transform: rotate(90deg); }
  .as-brick input[type='checkbox'] { accent-color: var(--as-accent); width: 15px; height: 15px; margin: 0; }
  .as-slider {
    display: grid;
    grid-template-columns: 78px minmax(0, 1fr) 44px;
    align-items: center;
    gap: 8px;
    padding: 4px 10px 8px;
    color: #c4c8d0;
  }
  .as-slider input { width: 100%; accent-color: #d8dbe0; }
  .as-slider output {
    font-variant-numeric: tabular-nums;
    text-align: right;
    color: #eceef2;
    font-size: 0.8rem;
  }
  .as-brick:has(input[type='checkbox']:not(:checked)) .as-slider { opacity: 0.45; }
  .as-inspector-note {
    margin: auto 0 0;
    padding: 10px 4px 2px;
    color: #8a909b;
    font-size: 0.76rem;
    line-height: 1.45;
  }

  .as-chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding: 0;
    margin: 34px 0 0;
  }
  .as-chips li {
    font-size: 0.9rem;
    color: var(--as-text);
    background: var(--as-panel-2);
    border: 1px solid var(--as-line);
    border-radius: 999px;
    padding: 0.45rem 0.95rem;
  }
  .as :is(.as-chips, .as-keytable, .as-chapter-body) kbd {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.82em;
    color: var(--as-text);
    background: #0b0d11;
    border: 1px solid var(--as-line);
    border-bottom-width: 2px;
    border-radius: 6px;
    padding: 1px 6px;
    margin-left: 4px;
    white-space: nowrap;
  }

  /* ── Select ───────────────────────────────────────────────────────── */
  .as-select-demo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    border: 1px solid var(--as-line);
    border-radius: 20px;
    overflow: hidden;
    background: #1e2127;
    box-shadow: 0 40px 120px rgba(0, 0, 0, 0.6);
  }
  .as-select-photo {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #141518;
    padding: 18px;
  }
  .as-select-stage {
    position: relative;
    width: 100%;
    border-radius: 4px;
    overflow: hidden;
    cursor: crosshair;
    touch-action: manipulation;
  }
  .as-select-stage img {
    display: block;
    width: 100%;
    height: auto;
    user-select: none;
    -webkit-user-drag: none;
  }
  .as-select-base { filter: var(--base-filter, none); }
  .as-select-layer {
    position: absolute;
    inset: 0;
    filter: var(--layer-filter, none);
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    visibility: hidden;
  }
  .as-select-layer.is-on { visibility: visible; }
  .as-select-outline {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .as-select-hint {
    position: absolute;
    left: 50%;
    bottom: 14px;
    transform: translateX(-50%);
    margin: 0;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    background: rgba(10, 12, 16, 0.72);
    backdrop-filter: blur(8px);
    color: #eceef2;
    font-size: 0.82rem;
    pointer-events: none;
    transition: opacity 0.3s ease;
    white-space: nowrap;
  }
  .as-select-hint.is-gone { opacity: 0; }
  .as-select-found { padding: 4px 2px 6px; }
  .as-select-score {
    margin: 0 0 8px;
    font-weight: 650;
    color: #eceef2;
    font-variant-numeric: tabular-nums;
  }
  .as-select-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
  }
  .as-select-list button {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 6px 8px;
    border-radius: 7px;
    border: 1px dashed #4a4f59;
    background: transparent;
    color: #8a909b;
    font: inherit;
    font-size: 0.8rem;
    text-align: left;
    cursor: pointer;
  }
  .as-select-list button:hover { border-color: #6b717c; }
  .as-select-q {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #3a3e46;
    color: #c4c8d0;
    font-size: 0.7rem;
    font-weight: 700;
  }
  .as-select-name { visibility: hidden; }
  .as-select-list button.is-found { border-style: solid; border-color: #3b4250; color: #eceef2; }
  .as-select-list button.is-found .as-select-name { visibility: visible; }
  .as-select-list button.is-found .as-select-q { background: var(--as-good); color: #08130c; }
  .as-select-list button.is-current { border-color: var(--as-accent); background: rgba(111, 155, 255, 0.12); }
  .as-select-check {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px 8px;
    color: #c4c8d0;
  }
  .as-new { grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 28px; }
  .as-new .as-org-card p { margin: 0; color: var(--as-muted); line-height: 1.55; }
  .as-select-check input { accent-color: var(--as-accent); width: 15px; height: 15px; margin: 0; }
  .as-select-demo .as-slider:has(input:disabled),
  .as-select-check:has(input:disabled) { opacity: 0.45; }

  /* ── Loupe ─────────────────────────────────────────────────────────── */
  .as-loupe-stage {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid var(--as-line);
    box-shadow: 0 40px 120px rgba(0, 0, 0, 0.6);
    cursor: none;
  }
  .as-loupe-photo {
    display: block;
    width: 100%;
    height: auto;
  }
  .as-loupe {
    --size: 240px;
    position: absolute;
    left: 0;
    top: 0;
    width: var(--size);
    height: var(--size);
    margin: calc(var(--size) / -2) 0 0 calc(var(--size) / -2);
    border-radius: 50%;
    border: 8px solid #1b1d22;
