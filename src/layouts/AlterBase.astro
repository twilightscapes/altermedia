---
import '../styles/alter-global.css';

interface Props {
  title: string;
  description: string;
  /** Path to the social share image, relative to the site root. */
  image?: string;
  /** ALT text for the social share image. */
  imageAlt?: string;
  /** Pixel size of the share image. */
  imageWidth?: number;
  imageHeight?: number;
}
const {
  title,
  description,
  image = '/og-alter-continued.webp',
  imageAlt = 'The Alter share card. On the left, the Alter lens icon and wordmark above the headline “Aperture, continued.”, the line “Opens your Aperture library exactly as you left it.” and a green pill reading “Open source · Free for Mac”. On the right, Alter with an Aperture library open: the projects sidebar, a night photo of a glowing Futuro house in the viewer with a filmstrip below, and the Adjust inspector showing the photo’s Aperture edit as White Balance, Exposure, Enhance and Highlights & Shadows bricks.',
  imageWidth = 2400,
  imageHeight = 1260,
} = Astro.props;
const path = Astro.url.pathname;
const site = 'https://altermedia.app';
const imageUrl = new URL(image, site).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`${site}${path}`} />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/png" href="/images/alter-icon.png" />

    <!-- Open Graph -->
    <meta property="og:site_name" content="Alter" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${site}${path}`} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
  </head>
  <body>
    <slot />

    <footer class="site-footer">
      <p class="footer-fine">
        Alter is made by the team behind
        <a href="https://alttext.org">ALTtext.org</a> — a public resource for
        image accessibility.
      </p>
    </footer>
  </body>
</html>
